import Mathlib.Data.Finset.Card
import Mathlib.Order.Monotone.Basic

/-! Synthesis for monotone obligations generated by counts of protected coordinate blocks. -/
namespace DecisionQuotient.BlockProtection

variable {ι β : Type*} [DecidableEq ι] [DecidableEq β]

/-- Each coordinate has a label. A support supplies one occupancy count per label. -/
def counts (label : ι → β) (s : Finset ι) (b : β) : ℕ :=
  (s.filter fun i => label i = b).card

omit [DecidableEq ι] in
theorem counts_mono (label : ι → β) : Monotone (counts label) := by
  intro s t h b
  exact Finset.card_le_card (Finset.filter_subset_filter _ h)

/-- All subsets of the unprotected coordinates are admissible interventions. -/
def protects (ground protect : Finset ι) (bad : Finset ι → Prop) : Prop :=
  ∀ s ⊆ ground \ protect, ¬ bad s

/-- The largest admissible support is a single exact separation query for monotone badness. -/
theorem protects_iff_maximal (ground protect : Finset ι) (bad : Finset ι → Prop)
    (hm : Monotone bad) :
    protects ground protect bad ↔ ¬ bad (ground \ protect) := by
  constructor
  · exact fun h => h _ (by rfl)
  · exact fun h _ hs hb => h (hm hs hb)

/-- Protection of a monotone block law is determined by its residual occupancies. -/
theorem protects_iff_counts (label : ι → β) (ground protect : Finset ι)
    (law : (β → ℕ) → Prop) (h : Monotone law) :
    protects ground protect (fun s => law (counts label s)) ↔
      ¬ law (counts label (ground \ protect)) :=
  protects_iff_maximal _ _ _ (h.comp (counts_mono label))

theorem same_residual_counts (label : ι → β) (ground p q : Finset ι)
    (law : (β → ℕ) → Prop) (h : Monotone law)
    (he : counts label (ground \ p) = counts label (ground \ q)) :
    protects ground p (fun s => law (counts label s)) ↔
    protects ground q (fun s => law (counts label s)) := by
  rw [protects_iff_counts _ _ _ _ h, protects_iff_counts _ _ _ _ h, he]

/-- An upward-closed adversary can omit a single boundary support. -/
def punctured (k : ℕ) (hole s : Finset ι) : Prop :=
  k < s.card ∨ (k = s.card ∧ s ≠ hole)

theorem punctured_mono (k : ℕ) (hole : Finset ι) : Monotone (punctured k hole) := by
  intro s t hst hs
  have hc := Finset.card_le_card hst
  rcases hs with h | ⟨h, hne⟩
  · exact Or.inl (h.trans_le hc)
  · by_cases he : s = t
    · subst t
      exact Or.inr ⟨h, hne⟩
    · have hlt : s.card < t.card := lt_of_le_of_ne hc (fun e =>
        he (Finset.eq_of_subset_of_card_le hst e.ge))
      exact Or.inl (by omega)

omit [DecidableEq ι] in
/-- All membership answers outside the hole agree with the ordinary threshold. -/
theorem punctured_off_hole (k : ℕ) {hole s : Finset ι} (h : s ≠ hole) :
    punctured k hole s ↔ k ≤ s.card := by
  constructor
  · rintro (hl | ⟨he, _⟩)
    · exact hl.le
    · exact he.le
  · intro hl
    rcases lt_or_eq_of_le hl with hlt | heq
    · exact Or.inl hlt
    · exact Or.inr ⟨heq, h⟩

omit [DecidableEq ι] in
/-- A transcript missing a boundary point cannot distinguish two monotone laws. -/
theorem invisible_hole (queries : Finset (Finset ι)) (hole : Finset ι) (hh : hole ∉ queries) :
    (∀ s ∈ queries, punctured hole.card hole s ↔ hole.card ≤ s.card) ∧
      ¬ punctured hole.card hole hole := by
  constructor
  · intro s hs
    exact punctured_off_hole _ (fun he => hh (he ▸ hs))
  · simp [punctured]

end DecisionQuotient.BlockProtection
